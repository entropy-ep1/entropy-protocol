# Build and cache output only. Evidence (logs, results, runs) is tracked on purpose: a clean clone must hold every
# file a number in this repository stands on (see bench/logs, bench/results, runs_gpu). Never add a blanket *.log.
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
.DS_Store
# operational, per operator: the machine ledger carries live IPs; the launch, preparation and watcher logs on the
# operator's side carry the operator's own address (the SSH rule). The machines' run logs are evidence and live under
# runs_gpu/<machine>/logs.
bench/gpu/infra/instances.tsv
bench/gpu/infra/*.log
node_modules/
